<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test method names use Snake_Case_Like_This to read as sentences.
         CA1806 ("construct-and-discard") fires legitimately on negative
         constructor tests (`act = () => new Foo(badInput)`), which is the
         exact pattern we use to assert "this throws". -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1806</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- AwesomeAssertions: license-friendly FluentAssertions fork, the sole assertion library. -->
    <PackageReference Include="AwesomeAssertions" />
    <!-- Xunit.SkippableFact: xUnit 2 has no native Skip API, and a test that cannot run must
         report Skipped, never a silent green Pass. The rigctld interop tests gate on the
         binary being installed. -->
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- Banned-symbol analyzer: BannedSymbols.txt bans Xunit.Assert, so "AwesomeAssertions is
         the sole assertion library" is a build error (RS0030) rather than an aspiration. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
